# ═══════════════════════════════════════════════════════════════
# DFrage — Legal AI Workspace
# Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Ollama LLM Configuration ──────────────────────────────────
# Ollama service URL (Docker container exposes this on localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default model for inference
# Options: qwen2.5:3b (recommended for 4GB VRAM), phi3.5, llama3.2:3b
DEFAULT_MODEL=qwen2.5:3b

# Set to "mock" only for testing without Ollama running
# In production, leave this unset or set to "ollama"
MODEL_RUNTIME=ollama

# ── ChromaDB Configuration ────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Disable ChromaDB telemetry (fixes PostHog signature warnings)
ANONYMOUS_TELEMETRY=false

# ── Application ───────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── CORS / Origins ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
