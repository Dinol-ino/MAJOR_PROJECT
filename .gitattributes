# Normalise all text to LF in the repository. Prevents the whole tree from
# showing as modified when checked out on Windows.
* text=auto eol=lf

# Scripts that must keep CRLF to run on Windows
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary / never diff
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.webp         binary
*.pdf          binary
*.zip          binary
*.gz           binary
*.db           binary
*.sqlite       binary
*.sqlite3      binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.otf          binary
*.bin          binary
*.pt           binary
*.pth          binary
*.onnx         binary
*.safetensors  binary

# Generated - collapse in diffs and reviews
package-lock.json  linguist-generated=true
