# DFrag Environment Configurations Template
# Copy this file to .env and configure as needed

# Core Infrastructure
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=30.0
OLLAMA_GENERATION_TIMEOUT_SECONDS=180.0

CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./audit_log.db
CHROMA_LEGACY_ENABLED=true
ANONYMOUS_TELEMETRY=false

RETRIEVAL_EMBEDDINGS=local

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=dfrag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_CONNECT_TIMEOUT=5
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@127.0.0.1:5435/dfrag
PGVECTOR_DIMENSIONS=1024
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=7200

MAX_FILE_SIZE_MB=10
MAX_FILE_PAGES=100

# Defense and Trust Scoring
INJECTION_MODEL=local
INJECTION_BLOCK_THRESHOLD=0.7
INJECTION_REVIEW_THRESHOLD=0.4
TRUST_WEIGHT_SIMILARITY=0.4
TRUST_WEIGHT_SOURCE=0.3
TRUST_WEIGHT_INJECTION=0.2
TRUST_WEIGHT_FRESHNESS=0.1

# Generation and Output Guard
MODEL_RUNTIME=ollama
GENERATOR_MODEL=qwen2.5:3b
GENERATOR_CONTEXT_TOKENS=4096
HF_TOKEN=your_hf_token_here
PRESIDIO_ENABLED=true
NLI_MODEL=local
OUTPUT_QUARANTINE_MODE=quarantine

# Memory, Observability, and Admin Controls
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2
