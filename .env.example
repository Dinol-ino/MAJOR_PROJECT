# DFrag environment template. Copy to .env and fill in the values marked REQUIRED.
# Never commit .env. Values here are configuration, not secrets.

# --- Secrets (REQUIRED) -------------------------------------------------------
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY is mandatory: the backend refuses to start without it rather than
# generating a per-process key, which would break multi-worker deployments (each
# worker signing with a different secret) and drop every session on restart.
JWT_SECRET_KEY=
# Encrypts cloud provider keys at rest. Without it, storing cloud keys is refused.
SECRET_KEY=

# --- Authentication -----------------------------------------------------------
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PASSWORD_MIN_LENGTH=8
# Defaults to false: once the workspace has an owner, self-registration is closed.
# The first account can always register. Set true only to invite more practitioners.
AUTH_REGISTRATION_OPEN=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Model runtime ------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Used only until a model is activated in Hardware & Models (the choice is then persisted).
DEFAULT_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_PROBE_TIMEOUT_SECONDS=3
# -1 lets Ollama decide GPU offload; 0 forces CPU; N offloads N layers.
OLLAMA_NUM_GPU_LAYERS=-1
GENERATOR_CONTEXT_TOKENS=8192
# Downloads are explicit user actions by default.
AUTO_PULL_ON_STARTUP=false
AUTO_PULL_ON_DEMAND=false
MODEL_WARMUP_ON_STARTUP=true
MODEL_PULL_MAX_CONCURRENT=1
MODEL_PULL_MAX_ATTEMPTS=3
# Where downloaded models live (used for free-space checks). Defaults to the backend working dir.
MODELS_DISK_PATH=

# --- Storage ------------------------------------------------------------------
# Empty DATABASE_URL = local SQLite (SQLITE_DB_PATH). A PostgreSQL URL is used strictly:
# if it is unreachable the API returns 503 instead of silently writing to SQLite.
DATABASE_URL=
DB_ALLOW_SQLITE_FALLBACK=false
SQLITE_DB_PATH=./audit_log.db
CHROMA_PERSIST_DIR=./chroma_db
BM25_INDEX_DIR=./bm25_index
# Original uploaded documents (canonical copy; indexes above are rebuildable from it)
VAULT_FILES_DIR=./vault_files
# Statutory corpus: *.txt act files plus manifest.yaml (provenance). Defaults to ./data/acts_raw.
ACTS_RAW_DIR=
ANONYMIZED_TELEMETRY=false

# Docker Compose PostgreSQL (defaults match existing volumes; change for new deployments).
DFRAG_PG_USER=postgres
DFRAG_PG_PASSWORD=
DFRAG_PG_DB=dfrag_memory

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_EMBEDDINGS=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en
MAX_FILE_SIZE_MB=10
MAX_FILE_PAGES=100
UPLOAD_MAX_BATCH_FILES=10

# --- Reasoning budgets (LOW / MEDIUM / HIGH) -------------------------------------
# Every field of each profile can be overridden, e.g.:
# REASONING_HIGH_MAX_OUTPUT_TOKENS=2048
# REASONING_MEDIUM_RETRIEVAL_TOP_K=5

# --- Security -----------------------------------------------------------------
# Layer 1 blocks a request at or above this injection risk score.
INJECTION_RISK_THRESHOLD=0.7
# Layer 3: minimum answer/evidence overlap before a claim counts as grounded.
GROUNDING_OVERLAP_THRESHOLD=0.05
# Presidio PII detection and redaction.
ENABLE_PII_SCANNING=true
# Only for offline security evaluation: lets a request bypass Layers 1-3.
ALLOW_UNSHIELDED_BASELINE=false
# Applied to every route via SlowAPIMiddleware, not just the auth endpoints.
RATE_LIMIT_DEFAULT=100/minute

# --- Network ------------------------------------------------------------------
# OFFLINE blocks every outbound call (research, model-hub search, cloud key tests).
NETWORK_MODE=OFFLINE

# --- Cloud fallback (opt-in) --------------------------------------------------
CLOUD_FALLBACK_ENABLED=false
CLOUD_AUTO_FALLBACK=false
CLOUD_PROVIDER=grok
HF_TOKEN=

# --- Observability ------------------------------------------------------------
OBSERVABILITY_ENABLED=true
# Redacts PII and secrets from metrics and traces. Leave on.
OBSERVABILITY_REDACTION=true
METRICS_RETENTION_DAYS=30

# External legal data connectors (optional). Leave blank to disable; set real values only in .env.
VAQUILL_API_KEY=
ECOURTSINDIA_API_KEY=

# Optional: bounded LangGraph retrieval planner for multi-part questions (off by default)
AGENTIC_RETRIEVAL_ENABLED=false
# ECOURTSINDIA_BASE_URL=https://webapi.ecourtsindia.com
